<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>

        <!-- Note: Panth MegaMenu is configured in app/code/Panth/MegaMenu/view/frontend/layout/default_hyva.xml -->
        <!-- It adds a block inside topmenu_generic which is already in header-content -->
        <!-- No additional configuration needed here -->

        <!-- Add Free Shipping Progress to Minicart -->
        <referenceBlock name="cart-drawer">
            <block class="Magento\Framework\View\Element\Template"
                   name="cart-drawer.free-shipping-progress"
                   template="Magento_Theme::html/cart/free-shipping-progress.phtml"
                   before="cart-drawer.totals.before"/>
        </referenceBlock>

