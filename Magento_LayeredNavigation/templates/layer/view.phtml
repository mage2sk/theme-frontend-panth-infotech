    <script>
        function initLayeredNavigation() {
            return {
                isMobile: false,
                blockOpen: false,
                overlayOn: false,
                checkIsMobileResolution() {
                    this.isMobile = window.matchMedia('(max-width: 1023.98px)').matches;
                    if (!this.isMobile) {
                        this.blockOpen = false;
                    }
                },
                openDrawer() {
                    this.checkIsMobileResolution();
                    if (!this.isMobile) {
                        return;
                    }
                    this.blockOpen = true;
                    this.$nextTick(() => {
                        window.setTimeout(() => this.$refs.drawerClose.focus(), 60);
                    });
                },
                closeDrawer() {
                    if (!this.blockOpen) {
                        return;
                    }
                    this.blockOpen = false;
                    this.$nextTick(() => this.$refs.filtersToggle.focus());
                },
                focusableItems() {
                    const selector = 'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
                    return Array.from(this.$refs.drawer.querySelectorAll(selector))
                        .filter((el) => el.getClientRects().length > 0 && getComputedStyle(el).visibility !== 'hidden');
                },
                trapFocus(event) {
                    if (!this.blockOpen || !this.isMobile) {
                        return;
                    }
                    const items = this.focusableItems();
                    if (!items.length) {
                        event.preventDefault();
                        return;
                    }
                    const first = items[0];
                    const last = items[items.length - 1];
                    const current = document.activeElement;
                    if (event.shiftKey && (current === first || !this.$refs.drawer.contains(current))) {
                        event.preventDefault();
                        last.focus();
                    } else if (!event.shiftKey && (current === last || !this.$refs.drawer.contains(current))) {
                        event.preventDefault();
                        first.focus();
                    }
                },
                setOverlay(on) {
                    if (on === this.overlayOn) {
                        return;
                    }
                    this.overlayOn = on;
                    [document.documentElement, document.body].forEach((el) => {
                        el.classList.toggle('panth-overlay-open', on);
                        el.classList.toggle('panth-filters-open', on);
                    });
                },
                syncOverlay() {
                    this.setOverlay(this.blockOpen && this.isMobile);
                },
                closeOnEscape() {
                    if (!this.blockOpen || !this.isMobile) {
                        return;
                    }
                    this.closeDrawer();
                }
            }
        }
    </script>
<?php endif; ?>
